            "subtasks": [
                {
                    "tags": "",
                    "parent_reminder": "Insights",
                    "due_date": "",
                    "notes": "Adds context and warnings you never thought to ask for.",
                    "flagged": false,
                    "list": "🤖 AI Prompt",
                    "priority": "None",
                    "name": "What else should I know?",
                    "url": ""
                },
                {
                    "tags": "",
                    "parent_reminder": "Insights",
                    "due_date": "",
                    "notes": "Stops it being a neutral helper and gets an actual opinion — better than a balanced list of options.",
                    "flagged": false,
                    "list": "🤖 AI Prompt",
                    "priority": "None",
                    "name": "What would you do in my shoes?",
                    "url": ""
                },
                {
                    "tags": "",
                    "parent_reminder": "Insights",
                    "due_date": "",
                    "notes": "Stops it reaching for the default answer. Same question, fresh track.",
                    "flagged": false,
                    "list": "🤖 AI Prompt",
                    "priority": "None",
                    "name": "Let’s think about this differently.",
                    "url": ""
                },
                {
                    "tags": "",
                    "parent_reminder": "Insights",
                    "due_date": "",
                    "notes": "Makes it argue both sides of its own answer. You get the full picture instead of just the obvious take.",
                    "flagged": false,
                    "list": "🤖 AI Prompt",
                    "priority": "None",
                    "name": "Play devil’s advocate against yourself.",
                    "url": ""
                },
                {
                    "tags": "",
                    "parent_reminder": "Insights",
                    "due_date": "",
                    "notes": "Gets past obvious advice to weird strategies that actually work. “What’s the counterintuitive move for networking?” reveals approaches nobody else uses.",
                    "flagged": false,
                    "list": "🤖 AI Prompt",
                    "priority": "None",
                    "name": "What’s the counterintuitive move here?",
                    "url": ""
                }
            ],
            "flagged": false,
            "list": "🤖 AI Prompt",
            "priority": "None",
            "name": "Insights",
            "url": ""
        },
