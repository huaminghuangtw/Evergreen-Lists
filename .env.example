# Copy to .env.local (ignored) and fill in, or export the same names.
# Only the Google Sheets sync (`node .scripts/main.mjs gsheet`) needs these;
# `md` and `pdf` read non-secret metadata from config.json and need nothing.
#
# Values come from `API Credentials.Google` in
# ~/Library/Mobile Documents/com~apple~CloudDocs/Documents/JSONFiles/config.json
# (clientID is ~72 chars ending in .apps.googleusercontent.com, clientSecret
# starts with GOCSPX-, refreshToken starts with 1//).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional override, defaults to https://oauth2.googleapis.com/token
# GOOGLE_TOKEN_ENDPOINT=
